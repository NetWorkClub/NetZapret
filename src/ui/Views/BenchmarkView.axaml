<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetZapret.UI.ViewModels"
             x:Class="NetZapret.UI.Views.BenchmarkView"
             x:DataType="vm:MainWindowViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    
    <!-- ================= TOP HERO BENCHMARK CARD ================= -->
    <Border Grid.Row="0" Classes="card-hero">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
        
        <!-- Header & Action Row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Тестирование и автоподбор" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="{Binding BenchmarkStatusText}"
                       FontSize="11"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!-- Mode Selector ComboBox -->
          <ComboBox Grid.Column="1"
                    SelectedIndex="{Binding SelectedBenchmarkModeIndex}"
                    IsEnabled="{Binding !IsBenchmarkRunning}"
                    VerticalAlignment="Center"
                    Width="200">
            <ComboBoxItem Content="Standard (HTTP/TLS + Ping)" />
            <ComboBoxItem Content="Quick (3 быстрые цели)" />
            <ComboBoxItem Content="DPI Checkers (TCP 16-20)" />
          </ComboBox>

          <!-- Run / Cancel Actions -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="primary"
                    Command="{Binding RunBenchmarkCommand}"
                    IsEnabled="{Binding !IsBenchmarkRunning}"
                    Padding="14,7">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <PathIcon Grid.Column="0" Data="{StaticResource IconPlay}" Width="10" Height="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Запустить" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button Classes="danger"
                    Command="{Binding CancelBenchmarkCommand}"
                    IsVisible="{Binding IsBenchmarkRunning}"
                    Padding="14,7">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <PathIcon Grid.Column="0" Data="{StaticResource IconStop}" Width="10" Height="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Отмена" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Progress Bar (Slim 2px) -->
        <ProgressBar Grid.Row="1"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding BenchmarkProgressPercent}"
                     Height="2" />

        <!-- Best Strategy Status & Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBlock Grid.Column="0"
                     Text="{Binding BestStrategySummary}"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondary}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <Button Grid.Column="1"
                  Command="{Binding OpenTargetsEditorCommand}"
                  IsEnabled="{Binding !IsBenchmarkRunning}"
                  FontSize="11"
                  Padding="10,5">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
              <PathIcon Grid.Column="0" Data="{StaticResource IconTarget}" Width="11" Height="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Цели тестирования" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Grid.Column="2"
                  Classes="primary"
                  Command="{Binding ApplyBestStrategyCommand}"
                  IsVisible="{Binding HasBestStrategy}"
                  FontSize="11"
                  Padding="10,5">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
              <PathIcon Grid.Column="0" Data="{StaticResource IconStar}" Width="11" Height="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Применить лучшую" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Grid.Column="3"
                  Command="{Binding OpenLastReportCommand}"
                  IsVisible="{Binding HasLastReport}"
                  FontSize="11"
                  Padding="10,5">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
              <PathIcon Grid.Column="0" Data="{StaticResource IconExternalLink}" Width="11" Height="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Открыть отчёт" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Grid>

      </Grid>
    </Border>

    <!-- ================= STRATEGIES & RESULTS HEADER ================= -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
      <TextBlock Grid.Column="0"
                 Text="Стратегии для проверки и результаты"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}"
                 VerticalAlignment="Center" />

      <Button Grid.Column="1"
              Command="{Binding SelectAllStrategiesForTestCommand}"
              IsEnabled="{Binding !IsBenchmarkRunning}"
              FontSize="11"
              Padding="8,4">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconCheckAll}" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Выбрать все" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <Button Grid.Column="2"
              Command="{Binding UnselectAllStrategiesForTestCommand}"
              IsEnabled="{Binding !IsBenchmarkRunning}"
              FontSize="11"
              Padding="8,4">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconCross}" Width="10" Height="10" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Снять все" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Grid>

    <!-- ================= MAIN BENCHMARK WORKSPACE ================= -->
    <Grid Grid.Row="2" ColumnDefinitions="240,*" ColumnSpacing="12">
      
      <!-- Left Column: Strategy Checklist -->
      <Border Grid.Column="0" Classes="card" Padding="8">
        <ScrollViewer Padding="0,0,6,0">
          <ItemsControl ItemsSource="{Binding Strategies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StrategyItemVm">
                <CheckBox IsChecked="{Binding IsSelectedForTest}"
                          Content="{Binding DisplayTitle}"
                          Margin="2,2"
                          FontSize="11" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Right Column: Results Table -->
      <Border Grid.Column="1" Classes="card" Padding="10">
        <Grid RowDefinitions="Auto,*">
          
          <!-- Table Header -->
          <Grid Grid.Row="0"
                ColumnDefinitions="*,50,50,55,60,65,75,75"
                Margin="4,0,12,8">
            <Button Grid.Column="0" Content="Стратегия ⇅" Command="{Binding SortBenchmarkCommand}" CommandParameter="name" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="OK ⇅" Command="{Binding SortBenchmarkCommand}" CommandParameter="ok" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <Button Grid.Column="2" Content="ERR ⇅" Command="{Binding SortBenchmarkCommand}" CommandParameter="err" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="UNSUP" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="4" Content="BLOCK ⇅" Command="{Binding SortBenchmarkCommand}" CommandParameter="blocked" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <Button Grid.Column="5" Content="Пинг ⇅" Command="{Binding SortBenchmarkCommand}" CommandParameter="ping" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <Button Grid.Column="6" Content="Итог ⇅" Command="{Binding SortBenchmarkCommand}" CommandParameter="best" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="7" Text="" />
          </Grid>

          <!-- Table Content Rows -->
          <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding BenchmarkResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BenchmarkRowVm">
                  <Border Background="#101013"
                          BorderThickness="0"
                          CornerRadius="6"
                          Padding="8,6"
                          Margin="0,0,0,4">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,50,50,55,60,65,75,75">
                        <TextBlock Grid.Column="0" Text="{Binding StrategyName}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding OkCount}" FontSize="12" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding FailCount}" FontSize="12" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding UnsupportedCount}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding BlockedCount}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding AvgPingText}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="{Binding StatusBadge}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="7"
                                Content="{Binding ExpandButtonText}"
                                Command="{Binding ToggleExpandCommand}"
                                IsVisible="{Binding HasDetails}"
                                FontSize="10"
                                Padding="6,2"
                                HorizontalAlignment="Right" />
                      </Grid>

                      <!-- Expanded Details Section -->
                      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="4" Margin="2,2,2,0">
                        <Border Background="#201113"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="8,4"
                                IsVisible="{Binding HasError}">
                          <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding TargetDetails}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BenchmarkTargetDetailVm">
                              <Border Background="#141418"
                                      BorderThickness="0"
                                      CornerRadius="4"
                                      Padding="8,4"
                                      Margin="0,0,0,2">
                                <StackPanel Spacing="2">
                                  <Grid ColumnDefinitions="160,85,85,85,*" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{Binding TargetName}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Http11Status, StringFormat='HTTP: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tls12Status, StringFormat='TLS1.2: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Tls13Status, StringFormat='TLS1.3: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PingText, StringFormat='Ping: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                                  </Grid>
                                  <TextBlock Text="{Binding ErrorHint}"
                                             FontSize="10"
                                             Foreground="{StaticResource AccentRed}"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>