<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetZapret.UI.ViewModels"
        x:Class="NetZapret.UI.Views.StrategyDetailsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding EditorTitle}"
        Width="800"
        Height="660"
        MinWidth="660"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="#09090B">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20,32,20,16" RowSpacing="12">
    
    <!-- Title Header -->
    <TextBlock Grid.Row="0" Text="{Binding EditorTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />

    <TabControl Grid.Row="1" SelectedIndex="{Binding EditorTabIndex}">
      <TabItem Header="Последний тест">
        <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,10,0,0">
          
          <Border Grid.Row="0" Classes="card" Padding="12" IsVisible="{Binding !EditorHasLastBenchmark}">
            <TextBlock Text="Эта стратегия ещё не проверялась. Запустите тестирование на вкладке «Тесты и подбор»."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" />
          </Border>

          <Border Grid.Row="0" Classes="card" Padding="12" IsVisible="{Binding EditorHasLastBenchmark}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding EditorTargetLastBenchmark.StrategyName, FallbackValue=''}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding EditorTargetLastBenchmark.StatusBadge, FallbackValue=''}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
              
              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="OK" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EditorTargetLastBenchmark.OkCount, FallbackValue='0'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" />
              </StackPanel>
              
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="ERR" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EditorTargetLastBenchmark.FailCount, FallbackValue='0'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center" />
              </StackPanel>
              
              <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                <TextBlock Text="UNSUP" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EditorTargetLastBenchmark.UnsupportedCount, FallbackValue='0'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
              </StackPanel>
              
              <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                <TextBlock Text="BLOCK" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EditorTargetLastBenchmark.BlockedCount, FallbackValue='0'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
              </StackPanel>
              
              <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                <TextBlock Text="Ср. пинг" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EditorTargetLastBenchmark.AvgPingText, FallbackValue='—'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="card" Padding="12" IsVisible="{Binding EditorHasLastBenchmark}">
            <ScrollViewer Padding="0,0,8,0">
              <StackPanel Spacing="6">
                <Border Background="#201113"
                        BorderThickness="0"
                        CornerRadius="4"
                        Padding="8,6"
                        IsVisible="{Binding EditorTargetLastBenchmark.HasError, FallbackValue=False}">
                  <TextBlock Text="{Binding EditorTargetLastBenchmark.Error, FallbackValue=''}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding EditorTargetLastBenchmark.TargetDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BenchmarkTargetDetailVm">
                      <Border Background="#101013"
                              BorderThickness="0"
                              CornerRadius="4"
                              Padding="8,6"
                              Margin="0,0,0,4">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="170,90,90,90,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="{Binding TargetName}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Http11Status, StringFormat='HTTP: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="2" Text="{Binding Tls12Status, StringFormat='TLS1.2: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="3" Text="{Binding Tls13Status, StringFormat='TLS1.3: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="4" Text="{Binding PingText, StringFormat='Ping: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                          </Grid>
                          <TextBlock Text="{Binding ErrorHint}"
                                     FontSize="10"
                                     Foreground="{StaticResource AccentRed}"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Параметры и конструктор">
        <Border Classes="card" Padding="14" Margin="0,10,0,0">
          <ScrollViewer Padding="0,0,10,0">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,160" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Название стратегии" FontSize="11" Foreground="{StaticResource TextMuted}" />
                  <TextBox Text="{Binding EditorName}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Категория" FontSize="11" Foreground="{StaticResource TextMuted}" />
                  <TextBox Text="{Binding EditorCategory}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="Описание" FontSize="11" Foreground="{StaticResource TextMuted}" />
                <TextBox Text="{Binding EditorDescription}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Web TCP (используйте {FAKES} перед именем .bin файла)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                <TextBox Text="{Binding EditorWebArgs}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Google / YouTube TCP (необязательно — если пусто, берётся из Web)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                <TextBox Text="{Binding EditorGoogleArgs}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Discord Media TCP (необязательно — если пусто, берётся из Google/Web)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                <TextBox Text="{Binding EditorDiscordMediaArgs}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" />
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="QUIC Repeats (1–20)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                  <TextBox Text="{Binding EditorQuicRepeats}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Game TCP Cutoff (n2 / n3 / n4 / n5)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                  <TextBox Text="{Binding EditorGameTcpCutoff}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>

    <!-- Bottom Controls -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
      <Button Grid.Column="0"
              Classes="danger"
              Command="{Binding DeleteCustomStrategyFromEditorCommand}"
              IsVisible="{Binding EditorCanDelete}"
              FontSize="11"
              Padding="10,6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconTrash}" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Удалить стратегию" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <TextBlock Grid.Column="1"
                 Text="{Binding EditorError}"
                 Foreground="{StaticResource AccentRed}"
                 FontSize="11"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />

      <Button Grid.Column="2"
              Click="OnCloseClick"
              FontSize="11"
              Padding="12,6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconCross}" Width="10" Height="10" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Закрыть" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <Button Grid.Column="3"
              Classes="primary"
              Command="{Binding SaveCustomStrategyCommand}"
              FontSize="11"
              Padding="14,6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconSave}" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding EditorSaveButtonText}" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Grid>

  </Grid>
</Window>