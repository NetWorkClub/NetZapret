<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetZapret.UI.ViewModels"
        xmlns:views="using:NetZapret.UI.Views"
        x:Class="NetZapret.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NetZapret"
        Width="1100"
        Height="700"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="#09090B">

  <!-- Root Layout: Sidebar (Col 0) + Content (Col 1) -->
  <Grid ColumnDefinitions="220,*">
    
    <!-- ================= SIDEBAR ================= -->
    <Border Grid.Column="0"
            Background="#0D0D10"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="0,0,1,0"
            Padding="14,32,14,14">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- App Title (Clean, no badges) -->
        <TextBlock Grid.Row="0"
                   Text="NetZapret"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="4,0,4,16" />

        <!-- Status Indicator (1 clean line) -->
        <Border Grid.Row="1"
                Classes="card"
                Padding="10,8"
                Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6"
                     Fill="{StaticResource AccentGreen}"
                     IsVisible="{Binding IsBypassRunning}"
                     VerticalAlignment="Center" />
            <Ellipse Width="6" Height="6"
                     Fill="{StaticResource TextMuted}"
                     IsVisible="{Binding !IsBypassRunning}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}"
                       FontWeight="Medium"
                       FontSize="12"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Navigation Items (Linear Style) -->
        <StackPanel Grid.Row="2" Spacing="3">
          <Button Classes="nav"
                  Classes.active="{Binding IsDashboardTab}"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Grid.Column="0" Data="{StaticResource IconShield}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Стратегии и запуск" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsBenchmarkTab}"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Grid.Column="0" Data="{StaticResource IconSpeedometer}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Тесты и подбор" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsFiltersTab}"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="2">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Grid.Column="0" Data="{StaticResource IconSliders}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Фильтры и списки" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsDiagnosticsTab}"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="3">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <PathIcon Grid.Column="0" Data="{StaticResource IconDiagnostics}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Диагностика" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <!-- Footer Actions (Minimal, NO version badges) -->
        <StackPanel Grid.Row="3" Spacing="6">
          <Button Classes="primary"
                  IsVisible="{Binding CanRestartElevated}"
                  Command="{Binding RestartAsAdminCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" HorizontalAlignment="Center">
              <PathIcon Grid.Column="0" Data="{StaticResource IconAdmin}" Width="12" Height="12" Foreground="#000000" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Запуск от админа" FontSize="11" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Command="{Binding RefreshStatusCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" HorizontalAlignment="Center">
              <PathIcon Grid.Column="0" Data="{StaticResource IconRefresh}" Width="12" Height="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Обновить статус" FontSize="11" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ================= MAIN CONTENT AREA ================= -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      
      <!-- Tab Content View Container -->
      <Grid Grid.Row="0" Margin="24,32,24,14">
        <views:DashboardView IsVisible="{Binding IsDashboardTab}" />
        <views:BenchmarkView IsVisible="{Binding IsBenchmarkTab}" />
        <views:FiltersView IsVisible="{Binding IsFiltersTab}" />
        <views:DiagnosticsView IsVisible="{Binding IsDiagnosticsTab}" />
      </Grid>

      <!-- Minimal Status Bar (Bottom) -->
      <Border Grid.Row="1"
              Background="#0D0D10"
              BorderBrush="{StaticResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              Padding="20,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding ActivityMessage}"
                     FontSize="11"
                     Foreground="{StaticResource TextMuted}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <ProgressBar Grid.Column="1"
                       IsIndeterminate="True"
                       Width="80"
                       Height="2"
                       IsVisible="{Binding IsBusy}"
                       VerticalAlignment="Center" />
        </Grid>
      </Border>

    </Grid>
  </Grid>
</Window>
