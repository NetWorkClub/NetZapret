<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetZapret.UI.ViewModels"
        x:Class="NetZapret.UI.Views.TargetsEditorWindow"
        x:Name="TargetsWin"
        x:DataType="vm:MainWindowViewModel"
        Title="Проверяемые домены и IP"
        Width="740"
        Height="560"
        MinWidth="600"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="#09090B">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20,32,20,16" RowSpacing="12">
    
    <!-- Top Header Bar -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Проверяемые домены и IP" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        <TextBlock Text="Используются при стандартном и быстром тестировании стратегий" FontSize="11" Foreground="{StaticResource TextMuted}" />
      </StackPanel>

      <Button Grid.Column="1"
              Command="{Binding ReloadTestTargetsCommand}"
              VerticalAlignment="Center"
              FontSize="11"
              Padding="10,5">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconRefresh}" Width="10" Height="10" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Сбросить" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <Button Grid.Column="2"
              Classes="primary"
              Command="{Binding SaveTestTargetsCommand}"
              VerticalAlignment="Center"
              FontSize="11"
              Padding="12,5">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
          <PathIcon Grid.Column="0" Data="{StaticResource IconSave}" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Сохранить" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Grid>

    <!-- Targets List Card -->
    <Border Grid.Row="1" Classes="card" Padding="10">
      <ScrollViewer Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding TestTargets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TargetItemVm">
              <Border Background="#101013"
                      BorderThickness="0"
                      CornerRadius="6"
                      Padding="8,5"
                      Margin="0,0,0,6">
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="Название" FontSize="11" />
                  <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="https://site.com или PING:1.1.1.1" FontSize="11" />
                  <Button Grid.Column="2"
                          Classes="danger"
                          Padding="8,5"
                          FontSize="10"
                          ToolTip.Tip="Удалить цель"
                          Command="{ReflectionBinding DataContext.RemoveTestTargetCommand, ElementName=TargetsWin}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
                      <PathIcon Grid.Column="0" Data="{StaticResource IconTrash}" Width="10" Height="10" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="Удалить" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Add New Target Card -->
    <Border Grid.Row="2" Classes="card" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="Добавить цель" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding NewTargetName}" Watermark="Имя (напр. Discord Voice)" FontSize="11" />
          <TextBox Grid.Column="1" Text="{Binding NewTargetValue}" Watermark="https://example.com или PING:8.8.8.8" FontSize="11" />
          <Button Grid.Column="2"
                  Classes="primary"
                  Command="{Binding AddTestTargetCommand}"
                  FontSize="11"
                  Padding="12,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
              <PathIcon Grid.Column="0" Data="{StaticResource IconPlus}" Width="10" Height="10" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Добавить" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Grid>
      </StackPanel>
    </Border>

  </Grid>
</Window>