<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetZapret.UI.ViewModels"
             x:Class="NetZapret.UI.Views.DashboardView"
             x:Name="DashRoot"
             x:DataType="vm:MainWindowViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    
    <!-- ================= TOP MASTER CONTROL CARD ================= -->
    <Border Grid.Row="0" Classes="card-hero" MinHeight="100">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        
        <!-- Left: Strategy Overview -->
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
          
          <!-- Strategy Name Title -->
          <TextBlock Text="{Binding SelectedStrategy.Name, FallbackValue='Выберите стратегию'}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" />

          <!-- Strategy Description -->
          <TextBlock Text="{Binding SelectedStrategy.Description, FallbackValue=''}"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondary}"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     MinHeight="28" />

          <!-- Global Warning (Subtle 1-line, no loud boxes) -->
          <TextBlock Text="Внимание: глобальный режим затрагивает весь IPv4 TCP-трафик."
                     FontSize="11"
                     Foreground="#EAB308"
                     IsVisible="{Binding SelectedStrategy.AdvancedWarning, FallbackValue=False}" />
        </StackPanel>

        <!-- Right: Actions -->
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MinWidth="180">
          
          <!-- Master Action Button -->
          <Button Classes="hero-action"
                  Classes.primary="{Binding !IsBypassRunning}"
                  Classes.danger="{Binding IsBypassRunning}"
                  Command="{Binding ToggleBypassCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Center">
              <PathIcon Grid.Column="0"
                        Data="{StaticResource IconPower}"
                        Width="12" Height="12"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ToggleBypassButtonText}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>

          <!-- Service Actions Row -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Content="Служба"
                    Command="{Binding InstallServiceCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="11"
                    Padding="8,5" />

            <Button Grid.Column="1"
                    Content="Удалить"
                    Command="{Binding RemoveServiceCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="11"
                    Padding="8,5" />
          </Grid>

        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= STRATEGIES HEADER (Clean, no badges) ================= -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
      <TextBlock Grid.Column="0"
                 Text="Стратегии"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}"
                 VerticalAlignment="Center" />

      <Button Grid.Column="1"
              Content="+ Своя"
              Command="{Binding OpenNewStrategyEditorCommand}"
              FontSize="11"
              Padding="10,5" />

      <Button Grid.Column="2"
              Content="Параметры"
              Command="{Binding OpenStrategyDetailsCommand}"
              CommandParameter="{Binding SelectedStrategy}"
              FontSize="11"
              Padding="10,5" />
    </Grid>

    <!-- ================= STRATEGIES LIST (Zero slop, zero pill soup) ================= -->
    <Border Grid.Row="2" Classes="card" Padding="4">
      <ListBox x:Name="StrategiesList"
               ItemsSource="{Binding Strategies}"
               SelectedItem="{Binding SelectedStrategy}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StrategyItemVm">
            <Grid ColumnDefinitions="*,Auto" Margin="4,2" ColumnSpacing="16">
              
              <!-- Left: Title & Description -->
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayTitle}"
                           FontWeight="Medium"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
              </StackPanel>

              <!-- Right: Clean Typography Meta (No pill borders!) -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Top Star (clean text, no badge box) -->
                <TextBlock Text="★"
                           FontSize="12"
                           Foreground="{StaticResource AccentGreen}"
                           IsVisible="{Binding IsLastBest}"
                           VerticalAlignment="Center" />

                <!-- Benchmark Latency (clean text) -->
                <TextBlock Text="{Binding LastBenchmarkSummary}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           IsVisible="{Binding HasLastBenchmark}"
                           VerticalAlignment="Center" />

                <!-- Category (clean muted text) -->
                <TextBlock Text="{Binding Category}"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

  </Grid>
</UserControl>
