<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetZapret.UI.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- Vector Icons (StreamGeometry) -->
    <StreamGeometry x:Key="IconShield">M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 7C13.1 7 14 7.9 14 9C14 9.74 13.6 10.38 13 10.72V15C13 15.55 12.55 16 12 16C11.45 16 11 15.55 11 15V10.72C10.4 10.38 10 9.74 10 9C10 7.9 10.9 7 12 7Z</StreamGeometry>
    <StreamGeometry x:Key="IconSpeedometer">M12 4C7.03 4 3 8.03 3 13C3 15.48 4 17.73 5.64 19.36C6.03 19.75 6.67 19.75 7.06 19.36C7.45 18.97 7.45 18.33 7.06 17.94C5.78 16.66 5 14.92 5 13C5 9.13 8.13 6 12 6C15.87 6 19 9.13 19 13C19 14.92 18.22 16.66 16.94 17.94C16.55 18.33 16.55 18.97 16.94 19.36C17.33 19.75 17.97 19.75 18.36 19.36C20 17.73 21 15.48 21 13C21 8.03 16.97 4 12 4ZM10.59 15.41C10.96 15.78 11.48 16 12 16C13.1 16 14 15.1 14 14C14 13.48 13.78 12.96 13.41 12.59L16 10L10.59 15.41Z</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M3 17V21H5V17H3ZM3 3V13H5V3H3ZM11 21H13V11H11V21ZM19 21H21V7H19V21ZM19 3V5H21V3H19ZM11 7H13V3H11V7ZM1 13V15H7V13H1ZM9 7V9H15V7H9ZM17 5V7H23V5H17Z</StreamGeometry>
    <StreamGeometry x:Key="IconDiagnostics">M3 13H5.5L7.5 7L11.5 20L14.5 10L16.5 15L18.5 13H21</StreamGeometry>
    <StreamGeometry x:Key="IconPower">M16.56 5.44C17.97 6.85 18.85 8.81 18.85 11C18.85 14.87 15.72 18 11.85 18C7.98 18 4.85 14.87 4.85 11C4.85 8.81 5.73 6.85 7.14 5.44M11.85 3V11</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8 5V19L19 12L8 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M6 6H18V18H6V6Z</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4C7.58 4 4.01 7.58 4.01 12C4.01 16.42 7.58 20 12 20C15.73 20 18.84 17.45 19.73 14H17.65C16.83 16.33 14.61 18 12 18C8.69 18 6 15.31 6 12C6 8.69 8.69 6 12 6C13.66 6 15.14 6.69 16.22 7.78L13 11H20V4L17.65 6.35Z</StreamGeometry>
    <StreamGeometry x:Key="IconAdmin">M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM9 6C9 4.34 10.34 3 12 3C13.66 3 15 4.34 15 6V8H9V6ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17Z</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z</StreamGeometry>
    <StreamGeometry x:Key="IconCross">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M19.14 12.94C19.18 12.63 19.2 12.32 19.2 12C19.2 11.68 19.18 11.37 19.14 11.06L21.41 9.29C21.61 9.13 21.67 8.84 21.54 8.61L19.4 4.9C19.27 4.67 19 4.58 18.76 4.68L16.08 5.75C15.53 5.33 14.92 4.98 14.26 4.71L13.86 1.86C13.82 1.61 13.6 1.43 13.35 1.43H9.07C8.82 1.43 8.6 1.61 8.56 1.86L8.16 4.71C7.5 4.98 6.89 5.33 6.34 5.75L3.66 4.68C3.42 4.58 3.15 4.67 3.02 4.9L0.88 8.61C0.75 8.84 0.81 9.13 1.01 9.29L3.28 11.06C3.24 11.37 3.22 11.69 3.22 12C3.22 12.31 3.24 12.63 3.28 12.94L1.01 14.71C0.81 14.87 0.75 15.16 0.88 15.39L3.02 19.1C3.15 19.33 3.42 19.42 3.66 19.32L6.34 18.25C6.89 18.67 7.5 19.02 8.16 19.29L8.56 22.14C8.6 22.39 8.82 22.57 9.07 22.57H13.35C13.6 22.57 13.82 22.39 13.86 22.14L14.26 19.29C14.92 19.02 15.53 18.67 16.08 18.25L18.76 19.32C19 19.42 19.27 19.33 19.4 19.1L21.54 15.39C21.67 15.16 21.61 14.87 21.41 14.71L19.14 12.94ZM11.21 15.5C9.28 15.5 7.71 13.93 7.71 12C7.71 10.07 9.28 8.5 11.21 8.5C13.14 8.5 14.71 10.07 14.71 12C14.71 13.93 13.14 15.5 11.21 15.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconExternalLink">M19 19H5V5H12V3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V12H19V19ZM14 3V5H17.59L7.76 14.83L9.17 16.24L19 6.41V10H21V3H14Z</StreamGeometry>

    <!-- Linear / Vercel Neutral Monochrome Design Tokens -->
    <SolidColorBrush x:Key="BgPrimary" Color="#09090B" />
    <SolidColorBrush x:Key="BgSidebar" Color="#0D0D10" />
    <SolidColorBrush x:Key="BgCard" Color="#131316" />
    <SolidColorBrush x:Key="BgCardHover" Color="#1A1A1E" />
    <SolidColorBrush x:Key="BgElevated" Color="#18181C" />
    <SolidColorBrush x:Key="BgInput" Color="#0E0E11" />

    <SolidColorBrush x:Key="BorderSubtle" Color="#222226" />
    <SolidColorBrush x:Key="BorderStrong" Color="#2E2E34" />
    <SolidColorBrush x:Key="BorderGlass" Color="#202024" />
    <SolidColorBrush x:Key="BorderGlassBright" Color="#323238" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMuted" Color="#71717A" />

    <!-- Functional Status Colors Only -->
    <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />
    <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
    <SolidColorBrush x:Key="AccentYellow" Color="#EAB308" />
    <SolidColorBrush x:Key="AccentBlue" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentCyan" Color="#D4D4D8" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Window Global Style -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource BgPrimary}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif" />
    </Style>

    <!-- Minimalist Cards (Linear style: flat, clean 1px border, compact radius) -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BgCard}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.card-hero">
      <Setter Property="Background" Value="{StaticResource BgCard}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.glass-elevated">
      <Setter Property="Background" Value="{StaticResource BgElevated}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Background" Value="{StaticResource BgElevated}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Buttons: Strict Vercel / Linear Style -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{StaticResource BgElevated}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgCardHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#222228" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Primary Button (Vercel Style: Solid White, Black Text) -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#09090B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#09090B" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E4E4E7" />
      <Setter Property="Foreground" Value="#09090B" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#D4D4D8" />
      <Setter Property="Foreground" Value="#09090B" />
    </Style>

    <!-- Success Button (Subtle Dark Emerald) -->
    <Style Selector="Button.success">
      <Setter Property="Background" Value="#0F2417" />
      <Setter Property="Foreground" Value="#4ADE80" />
      <Setter Property="BorderBrush" Value="#1D4A2B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.success /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F2417" />
      <Setter Property="Foreground" Value="#4ADE80" />
      <Setter Property="BorderBrush" Value="#1D4A2B" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#163823" />
      <Setter Property="Foreground" Value="#86EFAC" />
      <Setter Property="BorderBrush" Value="#25633A" />
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1F4C30" />
      <Setter Property="Foreground" Value="#86EFAC" />
      <Setter Property="BorderBrush" Value="#2E7546" />
    </Style>

    <!-- Danger Button (Subtle Dark Ruby) -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#241113" />
      <Setter Property="Foreground" Value="#F87171" />
      <Setter Property="BorderBrush" Value="#4C1D24" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="#241113" />
      <Setter Property="Foreground" Value="#F87171" />
      <Setter Property="BorderBrush" Value="#4C1D24" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#38171B" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#66222D" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#4A1E23" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#7E2836" />
    </Style>

    <!-- Hero Action Button -->
    <Style Selector="Button.hero-action">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Navigation Buttons (Linear Sidebar: ZERO flicker, stable colors) -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#17171C" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2A2A32" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2A2A32" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22222A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2A2A32" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2A2A32" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.nav PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="Button.nav:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="Button.nav.active PathIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Modern Monochrome Inputs -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource BgInput}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource BgInput}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Progress Bar -->
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#17171C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ListBox (Zero layout shift: BorderThickness is strictly 1px in all states) -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#17171C" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22222A" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>

</Application>
