    <StreamGeometry x:Key="IconCheckAll">M0.41 13.41L6 19L7.41 17.59L1.83 12M22.24 5.58L11.66 16.17L7.5 12L6.07 13.41L11.66 19L23.66 7M18 7L16.59 5.58L10.24 11.93L11.66 13.34L18 7Z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M9.5 3A6.5 6.5 0 0 1 16 9.5C16 11.11 15.41 12.59 14.44 13.73L14.71 14H15.5L20.5 19L19 20.5L14 15.5V14.71L13.73 14.44C12.59 15.41 11.11 16 9.5 16A6.5 6.5 0 0 1 3 9.5A6.5 6.5 0 0 1 9.5 3M9.5 5C7 5 5 7 5 9.5C5 12 7 14 9.5 14C12 14 14 12 14 9.5C14 7 12 5 9.5 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconEdit">M3 17.25V21H6.75L17.81 9.94L14.06 6.19L3 17.25ZM20.71 7.04C21.1 6.65 21.1 6.02 20.71 5.63L18.37 3.29C17.98 2.9 17.35 2.9 16.96 3.29L15.13 5.12L18.88 8.87L20.71 7.04Z</StreamGeometry>
    <StreamGeometry x:Key="IconBroom">M19.36 2.72L20.78 4.14L15.06 9.85C16.13 11.39 16.28 13.46 15.38 15.18L19.5 19.29L18.09 20.71L13.97 16.6C12.26 17.5 10.18 17.35 8.65 16.27L2.94 21.99L1.53 20.57L7.24 14.86C6.17 13.33 6.01 11.26 6.92 9.53L11.04 13.65L12.45 12.24L8.33 8.12C10.05 7.21 12.12 7.37 13.66 8.44L19.36 2.72Z</StreamGeometry>
    <StreamGeometry x:Key="IconExit">M16 17V14H9V10H16V7L21 12L16 17M14 2C15.11 2 16 2.9 16 4V6H14V4H5V20H14V18H16V20C16 21.1 15.11 22 14 22H5C3.89 22 3 21.1 3 20V4C3 2.9 3.89 2 5 2H14Z</StreamGeometry>
    <StreamGeometry x:Key="IconPanelLeft">M4 4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 4 4H4M4 6H8V18H4V6M10 6H20V18H10V6Z</StreamGeometry>

    <!-- Neutral Monochrome Design Tokens -->
    <SolidColorBrush x:Key="BgPrimary" Color="#09090B" />
    <SolidColorBrush x:Key="BgSidebar" Color="#0D0D10" />
    <SolidColorBrush x:Key="BgCard" Color="#131316" />
    <SolidColorBrush x:Key="BgCardHover" Color="#1A1A1E" />
    <SolidColorBrush x:Key="BgElevated" Color="#18181C" />
    <SolidColorBrush x:Key="BgInput" Color="#0E0E11" />

    <SolidColorBrush x:Key="BorderSubtle" Color="#222226" />
    <SolidColorBrush x:Key="BorderStrong" Color="#2E2E34" />
    <SolidColorBrush x:Key="BorderGlass" Color="#202024" />
    <SolidColorBrush x:Key="BorderGlassBright" Color="#323238" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMuted" Color="#71717A" />

    <!-- Functional Status Colors -->
    <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />
    <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
    <SolidColorBrush x:Key="AccentYellow" Color="#EAB308" />
    <SolidColorBrush x:Key="AccentBlue" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentCyan" Color="#D4D4D8" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Window Global Style -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource BgPrimary}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif" />
    </Style>

    <!-- Section Blocks & Cards: BORDERLESS sleek dark surfaces (reference style) -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BgCard}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.card-hero">
      <Setter Property="Background" Value="{StaticResource BgCard}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.glass-elevated">
      <Setter Property="Background" Value="{StaticResource BgElevated}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Background" Value="{StaticResource BgElevated}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Sidebar Layout & Transitions -->
    <Style Selector="Border.sidebar">
      <Setter Property="Width" Value="220" />
      <Setter Property="Padding" Value="12,32,12,14" />
    </Style>
    <Style Selector="Border.sidebar.collapsed">
      <Setter Property="Width" Value="58" />
      <Setter Property="Padding" Value="8,32,8,14" />
    </Style>

    <!-- Buttons: Outlined Only (Без фона, только границы) -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A22" />
      <Setter Property="BorderBrush" Value="#555566" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#242430" />
      <Setter Property="BorderBrush" Value="#777788" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1F1F24" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- Primary Button: Transparent with crisp bright border -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E4E4E7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#E4E4E7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A2A33" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#383844" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Success Button: Transparent with Emerald border -->
    <Style Selector="Button.success">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4ADE80" />
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.success /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#4ADE80" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0E2B19" />
      <Setter Property="BorderBrush" Value="#4ADE80" />
      <Setter Property="Foreground" Value="#86EFAC" />
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#173F25" />
      <Setter Property="BorderBrush" Value="#86EFAC" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Danger Button: Transparent with Crimson border -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F87171" />
      <Setter Property="BorderBrush" Value="#EF4444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#EF4444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F87171" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E1317" />
      <Setter Property="BorderBrush" Value="#F87171" />
      <Setter Property="Foreground" Value="#FCA5A5" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#421A20" />
      <Setter Property="BorderBrush" Value="#FCA5A5" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Icon-Only Minimalist Button (Header & Toggles) -->
    <Style Selector="Button.icon-only">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.icon-only /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.icon-only:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C1C24" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>

    <!-- Hero Action Button -->
    <Style Selector="Button.hero-action">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Navigation Buttons in Sidebar -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#141418" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A20" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A22" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#202028" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#4B4B58" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Collapsed Sidebar Adaptations -->
    <Style Selector="Border.sidebar.collapsed Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="Border.sidebar.collapsed Button">
      <Setter Property="Padding" Value="0,8" />
    </Style>

    <!-- Dynamic PathIcon Color Synchronization for all Buttons -->
    <Style Selector="Button PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button:pointerover PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button:pressed PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button:disabled PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="Button.nav PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="Button.nav:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.nav.active PathIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Modern Inputs -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource BgInput}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource BgInput}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Progress Bar -->
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#17171C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ListBox -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#17171C" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22222A" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E24" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>

</Application>